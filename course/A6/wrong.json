[
  {
    "ex": "e1",
    "name": "unstable merge (<)",
    "replace": [
      [
        "\t\tif a[i].Key <= b[j].Key {",
        "\t\tif a[i].Key < b[j].Key {"
      ]
    ],
    "expect": "stable"
  },
  {
    "ex": "e1",
    "name": "forgets the leftovers",
    "replace": [
      [
        "\tout = append(out, a[i:]...)\n\treturn append(out, b[j:]...)",
        "\treturn out"
      ]
    ],
    "expect": "merge"
  },
  {
    "ex": "e2",
    "name": "touching windows not merged",
    "replace": [
      [
        "w.Start <= out[n-1].End",
        "w.Start < out[n-1].End"
      ]
    ],
    "expect": "touching"
  },
  {
    "ex": "e2",
    "name": "end not maxed",
    "replace": [
      [
        "\t\t\tout[n-1].End = max(out[n-1].End, w.End)",
        "\t\t\tout[n-1].End = w.End"
      ]
    ],
    "expect": "inside another"
  },
  {
    "ex": "e2",
    "name": "sorts in place",
    "replace": [
      [
        "\tsorted := slices.Clone(ws)",
        "\tsorted := ws"
      ]
    ],
    "expect": "not changed"
  }
]