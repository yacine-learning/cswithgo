[
  {
    "ex": "e1",
    "name": "Get does not move to front",
    "replace": [
      [
        "\tc.order.MoveToFront(el)\n\treturn el.Value.(entry).value, true",
        "\treturn el.Value.(entry).value, true"
      ]
    ],
    "expect": "Get counts as a use"
  },
  {
    "ex": "e1",
    "name": "evicts the front",
    "replace": [
      [
        "\t\tback := c.order.Back()",
        "\t\tback := c.order.Front()"
      ]
    ],
    "expect": "evicts the least recently used|Get counts"
  },
  {
    "ex": "e1",
    "name": "forgets the map on eviction",
    "replace": [
      [
        "\t\tdelete(c.items, back.Value.(entry).key)\n",
        ""
      ]
    ],
    "expect": "map"
  }
]