[
  {
    "ex": "e1",
    "name": "forgets to copy",
    "replace": [
      [
        "\t\t\ta[k] = a[i]\n",
        ""
      ]
    ],
    "expect": "repeats in the middle"
  },
  {
    "ex": "e1",
    "name": "k starts at 0",
    "replace": [
      [
        "\tk := 1 // a[:k] holds the values kept so far",
        "\tk := 0"
      ]
    ],
    "expect": "panicked"
  },
  {
    "ex": "e2",
    "name": "strict <: b first on ties",
    "replace": [
      [
        "\t\tif a[i].T <= b[j].T {",
        "\t\tif a[i].T < b[j].T {"
      ]
    ],
    "expect": "equal times"
  },
  {
    "ex": "e2",
    "name": "forgets the leftovers",
    "replace": [
      [
        "\tout = append(out, a[i:]...)\n\treturn append(out, b[j:]...)",
        "\treturn out"
      ]
    ],
    "expect": "interleaved|before a|empty"
  }
]