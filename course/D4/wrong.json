[
  {
    "ex": "e1",
    "name": "no wrap-around",
    "replace": [
      [
        "\tback := (r.head + r.count) % len(r.buf) // wraps to the start of the array",
        "\tback := r.head + r.count"
      ]
    ],
    "expect": "wrapping around|panicked"
  },
  {
    "ex": "e1",
    "name": "head does not wrap",
    "replace": [
      [
        "\tr.head = (r.head + 1) % len(r.buf)",
        "\tr.head = r.head + 1"
      ]
    ],
    "expect": "wrapping around|panicked"
  },
  {
    "ex": "e1",
    "name": "no full check",
    "replace": [
      [
        "\tif r.count == len(r.buf) {\n\t\treturn false\n\t}\n",
        ""
      ]
    ],
    "expect": "full queue refuses|panicked|wrapping"
  },
  {
    "ex": "e2",
    "name": "stack instead of queue",
    "replace": [
      [
        "\t\tj := q[0]\n\t\tq = q[1:]",
        "\t\tj := q[len(q)-1]\n\t\tq = q[:len(q)-1]"
      ]
    ],
    "expect": "quantum"
  }
]